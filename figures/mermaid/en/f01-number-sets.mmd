flowchart LR
  subgraph R["R -- reals, e.g. pi"]
    direction LR
    subgraph Q["Q -- rationals, e.g. 1/3 and 0.1"]
      direction LR
      subgraph Z["Z -- integers, e.g. -3"]
        direction LR
        N["N -- 0, 1, 2, 3, ..."]
      end
    end
  end
  F["F -- what a machine stores:<br/>a FINITE subset of Q,<br/>and 0.1 is not in it"]
  Q -. "holds F; F holds no N or Z" .-> F
